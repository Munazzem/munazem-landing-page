{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/_expo/(.*)",
      "destination": "/app/_expo/$1"
    },
    {
      "source": "/app/_expo/(.*)",
      "destination": "/app/_expo/$1"
    },
    {
      "source": "/app/assets/(.*)",
      "destination": "/app/assets/$1"
    },
    {
      "source": "/manifest.json",
      "destination": "/app/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/app/sw.js"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/app/apple-touch-icon.png"
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "/app/apple-touch-icon.png"
    },
    {
      "source": "/app/manifest.json",
      "destination": "/app/manifest.json"
    },
    {
      "source": "/app/sw.js",
      "destination": "/app/sw.js"
    },
    {
      "source": "/app/apple-touch-icon.png",
      "destination": "/app/apple-touch-icon.png"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/Auth/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/Auth",
      "destination": "/app/index.html"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/auth",
      "destination": "/app/index.html"
    },
    {
      "source": "/child/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/home",
      "destination": "/app/index.html"
    },
    {
      "source": "/notifications",
      "destination": "/app/index.html"
    },
    {
      "source": "/attendance",
      "destination": "/app/index.html"
    },
    {
      "source": "/grades",
      "destination": "/app/index.html"
    },
    {
      "source": "/settings",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
