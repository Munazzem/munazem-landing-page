    {
      "source": "/settings",
      "destination": "/app/index.html"
    },
    {
      "source": "/settings/:path*",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/_expo/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
