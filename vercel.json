    },
    {
      "source": "/app/sw.js",
      "destination": "/app/sw.js"
    },
    {
      "source": "/app/apple-touch-icon.png",
      "destination": "/app/apple-touch-icon.png"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/Auth",
      "destination": "/app/index.html"
    },
    {
      "source": "/Auth/:path*",
      "destination": "/app/index.html"
    },
    {
